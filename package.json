{
  "name": "heyguy",
  "productName": "HeyGuy",
  "version": "0.1.0",
  "description": "A Clicky-style AI buddy for Windows: a blue cursor companion that sees your screen when you ask, listens, talks, and points at things.",
  "main": "dist/main/main.js",
  "author": "Thanmay",
  "license": "MIT",
  "private": true,
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node scripts/build.mjs --tests && node --test \"dist-test/*.test.cjs\"",
    "check": "npm run typecheck && npm test && npm run build",
    "start": "npm run build && electron .",
    "demo": "npm run build && electron . --demo",
    "demo:diagram": "npm run build && electron . --demo=diagram",
    "demo:3d": "npm run build && electron . --demo=3d",
    "demo:ui": "npm run build && electron . --demo=ui",
    "dist": "npm run build && electron-builder --win"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "@types/three": "^0.187.0",
    "electron": "45.2.2",
    "electron-builder": "26.18.0",
    "esbuild": "0.28.2",
    "typescript": "5.9.3",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/instrument-sans": "^5.3.0"
  },
  "build": {
    "appId": "dev.thanmay.heyguy",
    "productName": "HeyGuy",
    "files": [
      "dist/**/*",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "directories": {
      "output": "release",
      "buildResources": "assets"
    }
  },
  "dependencies": {
    "three": "0.187.0"
  }
}
