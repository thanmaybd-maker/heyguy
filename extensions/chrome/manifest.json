{
  "manifest_version": 3,
  "name": "HeyGuy Browser Companion",
  "version": "1.0.0",
  "description": "Enables HeyGuy desktop companion to safely assist with web workflows in user-authorized tabs.",
  "permissions": [
    "tabs",
    "activeTab",
    "scripting",
    "nativeMessaging"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}

